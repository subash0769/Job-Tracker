# Application Server Port
PORT=5000

# MongoDB Connection URI
# Local development default:
MONGO_URI=mongodb://localhost:27017/job_tracker

# Or granular MongoDB environment variables:
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DB=job_tracker
# MONGO_USER=admin
# MONGO_PASSWORD=secret

# CORS Allowed Origin (use * or comma-separated list of origins)
CORS_ORIGIN=*
